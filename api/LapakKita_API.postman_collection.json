    {
      "name": "Pesanan (Basic Auth pembeli)",
      "item": [
        {
          "name": "9. Buat pesanan (2 toko)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pesanan.php",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pesanan.php"
              ]
            },
            "description": "Membuat pesanan baru. Kopi (Dapur Bu Sari) dan Earphone (Toko Sinar Jaya) menjadi 2 pesanan.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nama_penerima\": \"Budi Santoso\",\n    \"no_hp\": \"081234567803\",\n    \"alamat_kirim\": \"Jl. Melati No. 21, Kota Bengkulu\",\n    \"metode_bayar\": \"cod\",\n    \"catatan\": \"Pesanan dari Postman\",\n    \"items\": [\n        {\n            \"id_produk\": 7,\n            \"jumlah\": 2\n        },\n        {\n            \"id_produk\": 1,\n            \"jumlah\": 1\n        }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{email_pembeli}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{password_pembeli}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('Dipecah menjadi 2 pesanan (satu per toko)', () => pm.expect(j.data.length).to.eql(2));",
                  "pm.test('Status awal menunggu', () => j.data.forEach(p => pm.expect(p.status).to.eql('menunggu')));",
                  "pm.collectionVariables.set('id_pesanan', j.data[0].id_pesanan);"
                ]
              }
            }
          ]
        },
